service auth {
  vsz_limit = 2G
}


passdb sql {
  driver = sql
  args = /tmp/docker-mailserver/dovecot/dovecot-sql.conf
}
userdb sql {
  driver = sql
  args = /tmp/docker-mailserver/dovecot/dovecot-sql.conf
}
